# ===========================================
# rust-green-webapp Backend Configuration
# ===========================================
# Copy this file to .env and configure as needed

# ===========================================
# LLM Configuration (Deepseek API)
# ===========================================
LLM_API_KEY=your-api-key-here
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_ENABLED=true
LLM_MAX_TOKENS=4000
LLM_TEMPERATURE=0.1
LLM_TIMEOUT=180
LLM_MAX_RETRIES=3
LLM_RETRY_DELAY=2
LLM_ENABLE_TOKEN_TRACKING=true

# ===========================================
# SAST Configuration
# ===========================================

# General SAST Settings
SAST_ENABLED=true
SAST_MAX_ISSUES_PER_SCAN=1000
SAST_FAIL_ON_TIMEOUT=false

# Clippy (Rust Linter) Settings
SAST_CLIPPY_ENABLED=true
SAST_CLIPPY_AUTO_FIX=true
SAST_CLIPPY_TIMEOUT=120
# SAST_CLIPPY_WARN_LINTS=["suspicious", "correctness", "style", "complexity", "perf"]

# Semgrep (SAST Scanner) Settings
SAST_SEMGREP_ENABLED=true
SAST_SEMGREP_AUTO_FIX=true
SAST_SEMGREP_TIMEOUT=300
SAST_SEMGREP_CONFIG=auto
# Set to true to run Semgrep in a Podman container
SAST_SEMGREP_USE_CONTAINER=false
SAST_SEMGREP_CONTAINER_IMAGE=docker.io/semgrep/semgrep:latest

# Cargo-audit (Dependency Scanner) Settings
SAST_CARGO_AUDIT_ENABLED=true
SAST_CARGO_AUDIT_TIMEOUT=60

# Podman Settings (for containerized tools)
SAST_PODMAN_PATH=podman

# ===========================================
# Database Configuration
# ===========================================
DATABASE_URL=sqlite+aiosqlite:///./rust_green.db

# ===========================================
# Server Configuration
# ===========================================
HOST=0.0.0.0
PORT=8000
DEBUG=false

# ===========================================
# File Storage Configuration
# ===========================================
UPLOAD_DIR=./uploads
SESSIONS_DIR=./sessions
MAX_UPLOAD_SIZE=10485760